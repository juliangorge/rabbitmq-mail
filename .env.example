# Default SMTP account. Queue messages can override with smtpHost, smtpUser, smtpPass.
SMTP_HOST=<host>
SMTP_USER=<user>
SMTP_PASS=<password>
# Existing broker host, or "rabbitmq" with: docker compose --profile rabbit up
RABBITMQ_SERVER=<server>
RABBITMQ_PORT=5672
RABBITMQ_USER=<user>
RABBITMQ_PASS=<password>
