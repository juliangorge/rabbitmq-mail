# Default SMTP account. Queue messages can override with smtpHost, smtpUser, smtpPass.
SMTP_HOST=<host>
SMTP_USER=<user>
SMTP_PASS=<password>
# Compose service name on first deploy. Use a host/IP if the broker already exists elsewhere.
RABBITMQ_SERVER=rabbitmq
RABBITMQ_PORT=5672
# Compose creates this user on first start (--profile rabbit)
RABBITMQ_USER=admin
RABBITMQ_PASS=<password>
